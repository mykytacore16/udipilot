{
  "name": "udipilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UDIPilot – asystent urzędnika do obsługi wniosków o dostęp do informacji publicznej",
  "scripts": {
    "setup": "npm install && npm --prefix client install && npm run build && node server/seed.js --if-empty",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "node server/seed.js",
    "samples": "node scripts/make-samples.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "docx": "^9.16.0",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "multer": "^1.4.4",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "pdfkit": "^0.21.0"
  }
}
